BOT_TOKEN=your-telegram-bot-token-from-botfather
DB_PATH=quizbot.db

# Telegram user IDs allowed to run /grantpro and /revokepro (comma-separated).
# Use /myid in the bot to find your own numeric ID.
ADMIN_IDS=123456789

# Optional: @username shown in /upgrade as a manual-payment contact
# (for admins who take cash, Click, Payme, bank transfer, etc.).
ADMIN_CONTACT_USERNAME=your_username

# Public URL of the standalone web portal (webapp/). Once set, granting Pro
# (via Stars, /grantpro, or /webportal) DMs the user a login for this URL.
WEB_URL=https://your-quiz-site.example.com
